{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "paths": {
      "foldkit-agent": ["../../packages/agent/src/index.ts"],
      "foldkit-agent-mcp": ["../../packages/agent-mcp/src/index.ts"],
      "foldkit-durable": ["../../packages/durable/src/index.ts"],
      "foldkit-sync": ["../../packages/sync/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    { "path": "../../packages/agent" },
    { "path": "../../packages/agent-mcp" },
    { "path": "../../packages/durable" },
    { "path": "../../packages/sync" }
  ]
}
