{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-agent": ["../../packages/agent/src/index.ts"],
      "foldkit-agent-a2a": ["../../packages/agent-a2a/src/index.ts"],
      "foldkit-agent-mcp": ["../../packages/agent-mcp/src/index.ts"],
      "foldkit-agent-native": ["../../packages/agent-native/src/index.ts"],
      "foldkit-agent-webmcp": ["../../packages/agent-webmcp/src/index.ts"],
      "foldkit-durable": ["../../packages/durable/src/index.ts"],
      "foldkit-mixins": ["../../packages/mixins/src/index.ts"],
      "foldkit-mixins-surface": ["../../packages/mixins-surface/src/index.ts"],
      "foldkit-mixins-ui": ["../../packages/mixins-ui/src/index.ts"],
      "foldkit-remote": ["../../packages/remote/src/index.ts"],
      "foldkit-remote-server": ["../../packages/remote-server/src/index.ts"],
      "foldkit-sync": ["../../packages/sync/src/index.ts"],
      "foldkit-surface": ["../../packages/surface/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    { "path": "../../packages/agent/tsconfig.build.json" },
    { "path": "../../packages/agent-a2a/tsconfig.build.json" },
    { "path": "../../packages/agent-mcp/tsconfig.build.json" },
    { "path": "../../packages/agent-native/tsconfig.build.json" },
    { "path": "../../packages/agent-webmcp/tsconfig.build.json" },
    { "path": "../../packages/durable/tsconfig.build.json" },
    { "path": "../../packages/mixins" },
    { "path": "../../packages/mixins-surface" },
    { "path": "../../packages/mixins-ui" },
    { "path": "../../packages/remote/tsconfig.build.json" },
    { "path": "../../packages/remote-drizzle" },
    { "path": "../../packages/remote-server/tsconfig.build.json" },
    { "path": "../../packages/sync/tsconfig.build.json" },
    { "path": "../../packages/surface/tsconfig.build.json" }
  ]
}
