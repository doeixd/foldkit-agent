{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-remote": ["../remote/src/index.ts"],
      "foldkit-remote-server": ["../remote-server/src/index.ts"],
      "foldkit-surface": ["../surface/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "bench/**/*.ts",
    "example/**/*.ts",
    "tsdown.config.ts"
  ],
  "references": [{ "path": "../remote" }, { "path": "../remote-server" }]
}
