{
  "name": "foldkit-plus-workspace",
  "private": true,
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "demo": "pnpm build && pnpm --filter foldkit-agent-example-todo demo && pnpm --filter foldkit-agent-example-sync demo",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "format": "prettier --write \"**/*.{ts,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yaml}\"",
    "pack:check": "pnpm build && pnpm -r --filter \"./packages/*\" exec pnpm pack",
    "release": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.158.2",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^2.1.8"
  }
}
